<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wheelby.Application\Wheelby.Application.csproj" />
    <ProjectReference Include="..\Wheelby.Domain\Wheelby.Domain.csproj" />
    <ProjectReference Include="..\Wheelby.Contracts\Wheelby.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Core\Permissions\Permissions.Contracts\Permissions.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Core\AccessControl\AccessControl.Contracts\AccessControl.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\SharedKernel\SharedKernel.csproj" />
