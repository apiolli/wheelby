# Copia este archivo a .env (cp .env.example .env) y ejecuta docker compose up --build.
# Con estos valores de ejemplo la aplicación arranca. Nunca subas .env al repositorio.

# --- Puerto de la API en tu máquina ---
# Si lo cambias, cambia también el puerto de App__ActivationUrl.
API_PORT=8080

# --- PostgreSQL (el compose arma ConnectionStrings__Postgres con estos valores) ---
POSTGRES_USER=wheelby
POSTGRES_PASSWORD=wheelby_local_123
POSTGRES_DB=wheelby

# --- Enlace del correo de activación (mismo puerto que API_PORT) ---
App__ActivationUrl=http://localhost:8080/auth/activate

# --- Credencial de sesión (JWT): clave aleatoria de al menos 32 caracteres ---
Jwt__Key=change_me_use_a_random_key_of_at_least_32_chars
Jwt__Issuer=wheelby
Jwt__Audience=wheelby-api
Jwt__ExpirationMinutes=60

# --- Administrador fijo: se crea al arrancar la API ---
# La contraseña necesita al menos 8 caracteres, con letras y números.
Admin__Email=admin@example.com
Admin__Password=change_me_Admin1

# --- SMTP para los correos de activación y recuperación ---
# Las credenciales reales se entregan en el comentario de Moodle.
# Con estos valores de ejemplo los correos quedan Pending en la cola.
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=usuario@example.com
Smtp__Password=change_me
Smtp__From=usuario@example.com

# --- Worker: segundos entre pasadas de la cola de correos ---
Worker__IntervalSeconds=10

# --- Manejador de documentos: tamaño máximo por archivo (10 MB) ---
Documents__MaxFileSizeBytes=10485760

# --- API externa de tasa de cambio (ExchangeRate-API) ---
# Sin una clave real, convertir precios responde 503 y el resto funciona.
ExchangeRate__ApiKey=tu_clave_de_exchangerate_api
